#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

def prompt(message, default: nil)
  suffix = default ? " [#{default}]" : ""
  print "#{message}#{suffix}: "
  input = $stdin.gets.chomp.strip
  input.empty? ? default : input
end

def yes?(message, default: true)
  hint = default ? "(Y/n)" : "(y/N)"
  print "#{message} #{hint}: "
  input = $stdin.gets.chomp.strip.downcase
  return default if input.empty?

  input == "y"
end

def brew_install_and_start(formula)
  if system("brew list #{formula} &>/dev/null")
    puts "#{formula} already installed."
  else
    puts "Installing #{formula}..."
    system!("brew install #{formula}")
  end

  if system("brew services list | grep #{formula} | grep started &>/dev/null")
    puts "#{formula} is already running."
  else
    puts "Starting #{formula}..."
    system!("brew services start #{formula}")
  end
end

FileUtils.chdir APP_ROOT do
  puts "== Checking Homebrew =="
  unless system("command -v brew &>/dev/null")
    abort "Homebrew is required but not installed. Visit https://brew.sh to install it."
  end

  puts "\n== Installing and starting services =="
  brew_install_and_start("postgresql@17")
  brew_install_and_start("redis")

  puts "\n== Installing overmind =="
  if system("brew list overmind &>/dev/null")
    puts "overmind already installed."
  else
    puts "Installing overmind..."
    system!("brew install overmind")
  end

  puts "\n== App Configuration =="
  app_name = nil

  loop do
    app_name = prompt("Enter the app name (lowercase, underscores)")
    break if app_name && app_name.match?(/\A[a-z][a-z0-9_]*\z/)

    puts "Invalid app name. Use lowercase letters, numbers, and underscores (must start with a letter)."
  end

  redis_db = nil

  loop do
    redis_db = prompt("Redis DB number (0-15, use a different number per project)", default: "0")
    break if redis_db.match?(/\A\d{1,2}\z/) && redis_db.to_i.between?(0, 15)

    puts "Must be a number between 0 and 15."
  end

  display_name = app_name.split("_").map(&:capitalize).join(" ")

  puts "\n== Generating .env =="
  if File.exist?(".env") && !yes?(".env already exists. Overwrite?", default: false)
    puts "Skipped .env generation."
  else
    env_contents = <<~ENV
      APP_NAME=#{app_name}
      VITE_APP_NAME=#{display_name}
      REDIS_URL=redis://localhost:6379/#{redis_db}
    ENV
    File.write(".env", env_contents)
    puts "Created .env with APP_NAME=#{app_name}, VITE_APP_NAME=#{display_name}, REDIS_URL using DB #{redis_db}"
  end

  puts "\n== Installing Ruby dependencies =="
  system! "gem install bundler --conservative"
  system("bundle check") || system!("bundle install")

  puts "\n== Installing JavaScript dependencies =="
  system! "npm install"

  puts "\n== Setting up database configuration =="
  if File.exist?("config/database.yml") && !yes?("config/database.yml already exists. Overwrite?", default: false)
    puts "Skipped database config."
  else
    FileUtils.cp "config/database.template.yml", "config/database.yml"
    puts "Copied database.template.yml -> database.yml"
  end

  puts "\n== Generating Rails credentials =="
  puts "This boilerplate ships with placeholder encrypted credentials."
  puts "Since this is a new project, you should regenerate them so your"
  puts "project has its own unique keys and secrets."
  puts ""
  puts "This is safe even though the old .yml.enc files are in git history:"
  puts "encrypted credential files are useless without their matching .key"
  puts "file, and .key files are gitignored and never committed.\n\n"

  %w[development test].each do |env|
    enc_file = "config/credentials/#{env}.yml.enc"
    key_file = "config/credentials/#{env}.key"
    exists = File.exist?(enc_file) || File.exist?(key_file)

    if exists
      unless yes?("Regenerate #{env} credentials?")
        puts "Skipped #{env} credentials."
        next
      end

      FileUtils.rm_f(enc_file)
      FileUtils.rm_f(key_file)
    end

    puts "Generating #{env} credentials..."
    system!(%(EDITOR="cat" bin/rails credentials:edit --environment #{env}))
    puts "#{env} credentials generated.\n\n"
  end

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  puts "\n== Restarting application server =="
  system! "bin/rails restart"

  puts "\n== Setup complete! =="
  puts "Your app '#{app_name}' is ready for development."
end
